<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_app_logo"
            android:contentDescription="@string/content_desc_logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/app_name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.01" />

        <ImageButton
            android:id="@+id/btnMoreMenu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more"
            android:contentDescription="@string/content_desc_more_options"
            android:padding="5dp"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="10dp">

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            android:layout_marginBottom="6dp" />

        <!-- Textové pole dostává v tomhle rozložení naprostou většinu obrazovky -
             veškeré ovládání je sloučené do jednoho scrollovatelného řádku dole. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="6dp">

            <EditText
                android:id="@+id/etContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:saveEnabled="false"
                android:importantForAutofill="no"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions"
                android:background="@drawable/bg_edittext_rounded"
                android:padding="12dp"
                android:paddingEnd="24dp"
                android:textSize="17sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:hint="@string/hint_content_text" />

            <io.github.marciano.smartreader.InteractiveScrollThumbView
                android:id="@+id/scrollThumb"
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:layout_gravity="end" />
        </FrameLayout>

        <!-- Jeden scrollovatelný řádek se vším ovládáním - na šířku je dost místa,
             a když by přece jen nestačilo na konkrétním telefonu, jde to
             doscrollovat vodorovně místo aby se cokoli neviditelně oříznulo. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:id="@+id/rowPasteClear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPaste"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/btn_paste"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_paste"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="16dp"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/text_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClear"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/btn_clear"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_clear"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="16dp"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/brand_danger" />
                </LinearLayout>

                <View
                    android:layout_width="1.5dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@color/text_secondary" />

                <LinearLayout
                    android:id="@+id/rowToolbarIcons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_toolbar_pill"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <ImageButton
                        android:id="@+id/btnImage"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_image"
                        android:tint="@color/brand_accent"
                        android:contentDescription="@string/content_desc_image"
                        android:padding="8dp"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/btnLink"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_link"
                        android:tint="@color/brand_accent"
                        android:contentDescription="@string/content_desc_link"
                        android:padding="8dp"
                        android:scaleType="fitCenter" />

                    <View
                        android:layout_width="1.5dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="7dp"
                        android:layout_marginEnd="7dp"
                        android:background="@color/text_secondary" />

                    <ImageButton
                        android:id="@+id/btnSave"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_save"
                        android:tint="@color/icon_secondary"
                        android:contentDescription="@string/content_desc_save"
                        android:padding="8dp"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/btnLibrary"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_library"
                        android:tint="@color/icon_secondary"
                        android:contentDescription="@string/content_desc_library"
                        android:padding="8dp"
                        android:scaleType="fitCenter" />

                    <View
                        android:layout_width="1.5dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="7dp"
                        android:layout_marginEnd="7dp"
                        android:background="@color/text_secondary" />

                    <ImageButton
                        android:id="@+id/btnHistory"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_history"
                        android:tint="@color/icon_secondary"
                        android:contentDescription="@string/content_desc_history"
                        android:padding="8dp"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/btnTrackedProfiles"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_tracked_profiles"
                        android:tint="@color/icon_secondary"
                        android:contentDescription="@string/content_desc_tracked_profiles"
                        android:padding="8dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>

                <View
                    android:layout_width="1.5dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@color/text_secondary" />

                <LinearLayout
                    android:id="@+id/rowSpeedSlider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_edittext_rounded"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <ImageButton
                        android:id="@+id/btnSpeedMinus"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_circle_button"
                        android:src="@drawable/ic_minus"
                        android:contentDescription="@string/content_desc_speed_minus"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />

                    <SeekBar
                        android:id="@+id/seekSpeed"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:progressTint="@color/brand_primary"
                        android:thumbTint="@color/brand_primary" />

                    <ImageButton
                        android:id="@+id/btnSpeedPlus"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_circle_button"
                        android:src="@drawable/ic_plus"
                        android:contentDescription="@string/content_desc_speed_plus"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/tvSpeedValue"
                        android:layout_width="46dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_primary"
                        android:text="1.00x" />
                </LinearLayout>

                <View
                    android:layout_width="1.5dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@color/text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlayPause"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/btn_play"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_play"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="18dp"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/brand_play" />

                <ImageButton
                    android:id="@+id/btnSkipPrev"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_circle_button"
                    android:src="@drawable/ic_skip_prev"
                    android:contentDescription="@string/content_desc_skip_prev"
                    android:padding="8dp"
                    android:scaleType="fitCenter" />

                <ImageButton
                    android:id="@+id/btnSkipNext"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_circle_button"
                    android:src="@drawable/ic_skip_next"
                    android:contentDescription="@string/content_desc_skip_next"
                    android:padding="8dp"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:id="@+id/stopButtonWrapper"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStop"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/btn_stop"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_stop"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="18dp"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/brand_accent" />
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>

</LinearLayout>
